# ============================================
# ResaCoiff — Variables d'environnement
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs

# --- SERVEUR ---
PORT=3000
NODE_ENV=production
APP_URL=https://votre-app.railway.app

# --- SESSION ---
# Clé secrète longue et aléatoire (changez absolument cette valeur !)
SESSION_SECRET=changez-cette-cle-secrete-longue-et-aleatoire-en-production

# --- BASE DE DONNÉES ---
# Chemin vers le fichier SQLite (laissez par défaut sur Railway)
DB_PATH=./data/resacoiff.db

# --- EMAIL (Nodemailer) ---
# Pour Gmail : activez l'authentification 2 facteurs et créez un "mot de passe d'application"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@gmail.com
SMTP_PASS=votre-mot-de-passe-app-gmail

# --- STRIPE (optionnel) ---
# Récupérez vos clés sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Pour les tests, utilisez sk_test_... et whsec_test_...
